# MySQL connection string used by Prisma migrations (prisma.config.ts)
DATABASE_URL="mysql://root:password@localhost:3306/expense_tracker"

# MySQL connection details used by the Prisma driver adapter at runtime
DATABASE_HOST="localhost"
DATABASE_USER="root"
DATABASE_PASSWORD="password"
DATABASE_NAME="expense_tracker"
DATABASE_PORT=3306

# Secret used to sign session JWTs. Use a long random string (min 16 chars).
AUTH_SECRET="change-me-to-a-long-random-secret-string-min-16-chars"

# SMTP for email verification (configure for your provider)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_SECURE=false

# Sender details for outgoing emails
MAIL_FROM_NAME="Expense Tracker"
MAIL_FROM_EMAIL="no-reply@expense-tracker.local"
