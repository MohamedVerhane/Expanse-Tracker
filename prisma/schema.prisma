generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  password           String
  emailVerifiedAt    DateTime?
  verificationTokens VerificationToken[]
  expenses           Expense[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([email])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal
  description String
  date        DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, amount])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  color    String
  expenses Expense[]

  @@index([slug])
}
